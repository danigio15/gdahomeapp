{
  "name": "gdahomeapp",
  "private": true,
  "type": "module",
  "description": "L'app di casa: la plancia, il ponte, e i comandi che in Home Assistant stanno nascosti.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:ponte && npm run test:centralino && npm run test:nuvola",
    "test:ponte": "node --test ponte/test/*.test.js",
    "test:centralino": "node --test centralino/test/*.test.js",
    "format": "prettier --write \"ponte/src/**/*.js\" \"ponte/test/**/*.js\" \"ponte/console/*.js\" \"ponte/console/*.css\" \"centralino/src/**/*.js\" \"centralino/test/**/*.js\" \"nuvola/src/**/*.js\" \"nuvola/test/**/*.js\" \"strumenti/*.mjs\" \"sito/*.js\" \"sito/*.css\" \"sito/index.html\"",
    "format:check": "prettier --check \"ponte/src/**/*.js\" \"ponte/test/**/*.js\" \"ponte/console/*.js\" \"ponte/console/*.css\" \"centralino/src/**/*.js\" \"centralino/test/**/*.js\" \"nuvola/src/**/*.js\" \"nuvola/test/**/*.js\" \"strumenti/*.mjs\" \"sito/*.js\" \"sito/*.css\" \"sito/index.html\"",
    "centralino": "node strumenti/centralino.mjs",
    "test:nuvola": "node --test nuvola/test/*.test.js"
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  }
}
