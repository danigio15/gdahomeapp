{
  "name": "gdahomeapp",
  "private": true,
  "type": "module",
  "description": "L'app di casa: la plancia, il ponte, e i comandi che in Home Assistant stanno nascosti.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:ponte && npm run test:centralino && npm run test:nuvola && npm run test:quadro",
    "test:ponte": "node --test ponte/test/*.test.js",
    "test:centralino": "node --test centralino/test/*.test.js",
    "format": "prettier --write \"ponte/src/**/*.js\" \"ponte/test/**/*.js\" \"ponte/carta/*.js\" \"ponte/console/*.js\" \"ponte/console/*.css\" \"ponte/console/*.html\" \"centralino/src/**/*.js\" \"centralino/test/**/*.js\" \"nuvola/src/**/*.js\" \"nuvola/test/**/*.js\" \"strumenti/**/*.mjs\" \"strumenti/video/*.js\" \"strumenti/video/*.html\" \"strumenti/video/*.css\" \"sito/*.js\" \"sito/*.html\" \"sito/*.css\" \"quadro/src/**/*.js\" \"quadro/test/**/*.js\" \"quadro/console/*.html\" \"quadro/gestore/*.html\" \"collaudo/guarda.mjs\" \"ponte/config.yaml\" \"ponte/build.yaml\" \"ponte/translations/*.yaml\" \"repository.yaml\"",
    "format:check": "prettier --check \"ponte/src/**/*.js\" \"ponte/test/**/*.js\" \"ponte/carta/*.js\" \"ponte/console/*.js\" \"ponte/console/*.css\" \"ponte/console/*.html\" \"centralino/src/**/*.js\" \"centralino/test/**/*.js\" \"nuvola/src/**/*.js\" \"nuvola/test/**/*.js\" \"strumenti/**/*.mjs\" \"strumenti/video/*.js\" \"strumenti/video/*.html\" \"strumenti/video/*.css\" \"sito/*.js\" \"sito/*.html\" \"sito/*.css\" \"quadro/src/**/*.js\" \"quadro/test/**/*.js\" \"quadro/console/*.html\" \"quadro/gestore/*.html\" \"collaudo/guarda.mjs\" \"ponte/config.yaml\" \"ponte/build.yaml\" \"ponte/translations/*.yaml\" \"repository.yaml\"",
    "centralino": "node strumenti/centralino.mjs",
    "test:nuvola": "node --test nuvola/test/*.test.js",
    "test:quadro": "node --test quadro/test/*.test.js"
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  }
}
