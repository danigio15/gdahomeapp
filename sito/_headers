# Quanto tenere in cache le cose, per Cloudflare Pages.
#
# Due velocita', e la ragione e' la stessa di sempre: quello che puo' cambiare
# da un minuto all'altro non si tiene, quello che cambia solo quando cambia la
# plancia si tiene volentieri.

# La pagina no: e' l'unica cosa che si riscrive spesso, e chi torna deve
# trovare quella nuova.
/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# La plancia sono ottocento file che cambiano solo quando esce una versione
# nuova di DashboardModern. Un giorno di cache, e chi torna il giorno dopo
# ricontrolla.
/dashboardmodern_static/*
  Cache-Control: public, max-age=86400

# Il marchio, le icone, i caratteri: stessa storia.
/statico/*
  Cache-Control: public, max-age=86400
