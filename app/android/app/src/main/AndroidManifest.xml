<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- La fotocamera serve a una cosa sola: inquadrare il codice a quadretti
         che collega l'app alla casa. Lo dichiara gia' il lettore di quadretti,
         e ridirlo qui non cambia niente al sistema — cambia a chi legge questo
         file e si chiede perche' un'app di casa voglia la fotocamera.

         `required="false"` perche' senza fotocamera l'app funziona lo stesso:
         le lettere sotto al quadretto si battono a mano. Senza questa riga il
         Play Store nasconderebbe l'app a chi ha un dispositivo senza. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- La plancia vibra: un colpetto a ogni tessera toccata, a ogni cambio
         di pagina, a ogni scena delle luci. Sono piu' di quaranta punti in
         cui chiama `navigator.vibrate`, e in un WebView Android senza questo
         permesso quella chiamata non fa niente e non dice niente: la plancia
         nel browser vibrava, nell'app no, e non si capiva perche'. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Il volto e l'impronta davanti all'app (#54): il lucchetto che si
         accende da Sicurezza.

         `USE_BIOMETRIC` e' un permesso normale — il sistema non chiede niente
         a nessuno, e a mostrare la finestra e' lui — ma senza questa riga
         BiometricPrompt non si apre.

         `required="false"` sulla feature perche' senza lettore l'app funziona
         com'e' sempre stata: il lucchetto non si puo' mettere, e le sue
         schermate lo dicono invece di offrire un tasto che non fa niente.
         Senza, il Play Store nasconderebbe l'app a chi ha un telefono senza
         lettore. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!-- La plancia vera dentro l'app passa da un server locale, su
         127.0.0.1: e' l'unico indirizzo in chiaro che il WebView puo'
         aprire, ed e' scritto in res/xml/network_security_config.xml.

         Niente copie di sicurezza, ne' nella nuvola ne' da un telefono
         all'altro: dentro l'app ci sono il segno della casa e la chiave del
         filo, e una copia li porterebbe fuori dal telefono. Tanto non
         servirebbero: sono cifrati con una chiave che sta nel portachiavi del
         telefono e non se ne va con la copia. Su un telefono nuovo si
         riabbina, come e' giusto. `allowBackup` vale fino ad Android 11,
         `dataExtractionRules` da Android 12 in poi. -->
    <application
        android:label="gdahome"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/regole_delle_copie"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- gdahome in auto (prova).

             In macchina non si disegna: Android Auto mostra i suoi modelli —
             liste, pannelli, griglie — e li impagina lui. Qui non c'e' la
             plancia, c'e' il poco che serve guidando: quanto sole c'e', chi e'
             in casa, e i tasti che uno tocca davvero.

             La categoria e' `IOT`, che e' quello che questa app e'. Dichiararne
             un'altra per entrare dove non si entrerebbe vorrebbe dire una
             revisione passata dicendo una cosa falsa. -->
        <service
            android:name=".auto.GdahomeCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
    </application>

    <!-- Qui **non** c'e' `android.hardware.type.automotive`, e non e' una
         dimenticanza: sono due cose diverse, e il negozio non le lascia
         dichiarare insieme.

         Quella riga e' di Android **Automotive**, il sistema che sta dentro
         l'auto. gdahome fa Android **Auto**: gira sul telefono, e in macchina
         ci arriva proiettata — la dichiara il `com.google.android.gms.car.application`
         qui sopra, e basta quello. Dichiarate tutt'e due, il Play Console
         rifiuta il pacchetto:

           «The app cannot declare 'android.hardware.type.automotive' device
            feature and 'com.google.android.gms.car.application' metadata at
            the same time.»

         E' costato un caricamento (la 1.6.4.1, prima corsa). Nessuna
         `uses-feature` serve: l'app resta quella di sempre su ogni telefono, e
         chi ha l'auto compatibile ci trova anche la macchina. -->
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
