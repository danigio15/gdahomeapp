<?xml version="1.0" encoding="utf-8"?>
<!-- Da Android 12 in poi: niente esce dall'app, ne' verso la copia nella
     nuvola ne' verso un telefono nuovo. Il perche' e' scritto nel manifesto,
     accanto a `allowBackup`. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
