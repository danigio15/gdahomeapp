<?xml version="1.0" encoding="utf-8"?>
<!-- gdahome in auto usa i modelli di Android, non disegna niente di suo: e' la
     sola cosa che un'app di questa categoria puo' fare, ed e' giusto cosi' —
     quello che si guarda guidando lo deve impaginare la macchina. -->
<automotiveApp>
    <uses name="template" />
    <!-- La musica di casa (le radio della plancia) che suona nel telefono in
         auto: con questa riga Android Auto la tratta come musica, cioe' la
         mostra nella sua scheda della musica e le manda i tasti del volante.
         Il servizio e' `ServizioLettoreDiCasa` di GdANav. -->
    <uses name="media" />
</automotiveApp>
