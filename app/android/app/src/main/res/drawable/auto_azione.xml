<?xml version="1.0" encoding="utf-8"?>
<!-- Un fulmine: le azioni rapide. Non e' un dispositivo e non deve sembrarlo —
     sta in un'altra schermata e porta un altro segno. -->
<!-- Bianco e pieno apposta: in macchina la tinta la mette l'ospite, secondo il
     tema chiaro o scuro dell'auto, e un disegno gia' colorato non si tinge.
     Percio' qui dentro una tinta non ci va: il colore lo decide un posto solo,
     e quel posto e' il `CarIcon` nel codice.

     128dp e non 24: e' la misura che Google chiede per i segni in auto, perche'
     gli schermi delle macchine vanno dal display del cruscotto al tablet in
     mezzo e il segno viene ingrandito. Il disegno resta lo stesso — le curve
     sono scritte in un riquadro di 24 e si allargano da sole. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13,2L4,14h6l-1,8l9,-12h-6L13,2z" />
</vector>
