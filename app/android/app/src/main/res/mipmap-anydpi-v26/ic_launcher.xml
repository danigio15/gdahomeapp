<?xml version="1.0" encoding="utf-8"?>
<!-- L'icona adattiva: il fondo e' il nero del logo, il primo piano e' il logo
     stesso rimpicciolito nella zona sicura. Android ritaglia un quarto per
     lato quando disegna il cerchio, e quello che sta fuori sparisce: il logo
     sta al 72% perche' il ritaglio non gli tagli via la casa. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/fondo_dell_icona"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
