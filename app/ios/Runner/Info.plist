<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>it</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>gdahome</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>gdahome</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Quello che l'iPhone scrive nel riquadro del permesso. E' l'unica
	     riga che l'utente legge prima di dire di si', e va detta per intero:
	     a cosa serve, e per quanto. -->
	<key>NSCameraUsageDescription</key>
	<string>Serve a inquadrare il codice a quadretti che collega l'app alla tua casa, e a scattare una foto da allegare a una segnalazione, se lo chiedi tu.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Serve a scegliere una foto o un video da allegare a una segnalazione, solo quando lo chiedi tu.</string>
	<!-- Il volto, per aprire l'app (#54). iOS chiede questa riga prima di
	     lasciar usare Face ID, e la mostra a chi installa. Il volto resta nel
	     telefono: da qui arriva un sì o un no, e basta. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Serve a riconoscerti quando apri gdahome, se accendi il lucchetto. Il tuo volto resta nel telefono: gdahome riceve solo un sì o un no.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Serve solo se registri un video da allegare a una segnalazione.</string>
	<!-- La casa sta sulla rete di casa, e da iOS 14 arrivarci vuole un
	     permesso a parte. Senza questa riga il sistema non chiede niente e non
	     dice niente: **rifiuta**, e l'app cerca la casa dove la casa c'e'
	     senza trovarla mai. Da fuori si passa dal centralino e questo non
	     serve; dentro casa e' la differenza fra funzionare e non funzionare,
	     ed e' esattamente il collegamento piu' veloce dei due. -->
	<!-- Il navigatore (gdanav, dentro l'app): la posizione per guidare, e il
	     Bluetooth per il dongle OBD che legge la batteria dell'auto. Tutte e
	     due solo quando si apre il navigatore. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Serve al navigatore, per mostrarti sulla mappa e guidarti fino a destinazione.</string>
	<!-- Con CarPlay acceso l'app sul telefono sta dietro, e la guida deve
	     continuare lo stesso: per questo anche «sempre», e in background
	     la posizione e la voce. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Serve al navigatore, per continuare a guidarti con lo schermo del telefono spento o mentre usi CarPlay.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Serve al navigatore solo se colleghi un dongle OBD, per leggere la batteria della tua auto.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Serve a parlare con la tua Home Assistant quando sei in casa, direttamente sulla tua rete, senza passare da internet. Fuori casa non viene usato.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<!-- La cifratura e' quella standard (X25519, HKDF, AES-GCM, e HTTPS):
	     esente, e TestFlight non si ferma a chiederlo a ogni versione. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- La plancia vera dentro l'app arriva al WebView da un server che sta
	     dentro l'app stessa, su 127.0.0.1, in chiaro: non esce dal telefono.
	     Senza questa eccezione l'iPhone rifiuta ogni http senza s, anche
	     verso se stesso. Vale per la rete locale e per quello che il WebView
	     apre; verso internet resta la regola di sistema. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
			<!-- CarPlay: il navigatore di gdanav, con la casa dietro il tasto
			     con la casetta (`LaCasaInCarPlay.swift`). -->
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>GdanavCarPlay</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Sull'iPad tutte e quattro: la plancia ha il suo formato largo, e
	     un'app per iPad che non gira da tutte le parti non puo' stare
	     accanto a un'altra (Split View). -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
