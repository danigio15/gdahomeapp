{
  "configVersion": "v3",
  "app": {
    "appId": 1137891,
    "appName": "GdAHome",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "gdahome",
    "description": "La casa al polso: luci, azioni rapide e cancelli"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": ["page/casa", "page/luci", "page/azioni", "page/luce", "page/esito"]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "it-IT": {
      "appName": "GdAHome"
    },
    "en-US": {
      "appName": "GdAHome"
    }
  },
  "defaultLanguage": "it-IT"
}
