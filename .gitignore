node_modules/
.DS_Store
*.log

# Roba del ponte in prova
/ponte/data/

# Quello che il quadro si scrive quando gira: le case che segue, coi nomi che
# gli ha dato l'installatore, e le impronte delle chiavi. E' roba di clienti di
# qualcuno, e in una repository non ci va nemmeno per sbaglio.
/quadro/dati/

# La chiave privata dell'albo. E' l'unico segreto di tutto questo: chi ce l'ha
# firma tesserini a nome di gdahome, e nessun ponte al mondo se ne accorge. Qui
# dentro non ci deve finire mai, e una riga nel .gitignore costa meno di un
# `git push` da annullare.
*.pem
/albo/dati/

# ─── Flutter ───────────────────────────────────────────────────────────────
# `android/` e `ios/` ci vanno dentro: sono configurazione del progetto, non
# roba costruita. Quello che si butta e' cio' che si rifa' con un comando.
/app/build/
/app/.dart_tool/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/.packages
/app/android/.gradle/
/app/android/local.properties
/app/android/app/debug/
/app/android/app/profile/
/app/android/app/release/
/app/ios/Pods/
/app/ios/.symlinks/
/app/ios/Flutter/Flutter.framework
/app/ios/Flutter/Flutter.podspec
/app/ios/Flutter/flutter_export_environment.sh
/app/ios/Flutter/Generated.xcconfig

# gdahome copiata accanto al centralino dal bottone «Il centralino»: e la
# stessa che sta in `ponte/app`, e una copia in piu nella repository non
# serve a nessuno.
nuvola/pubblico/

# La plancia vera, copiata nel sito da `node strumenti/porta-nel-sito.mjs`.
# Sono diciassette megabyte identici a quelli che stanno gia' in
# `ponte/plancia/`: una seconda copia nella repository non serve a nessuno, e
# si rifa' con un comando. Il bottone «Il sito» la rifa' prima di pubblicare.
/sito/dashboardmodern_static/

# Gli attrezzi usa-e-getta del collaudo: quelli che cominciano con «_».
# Servono a guardare una cosa una volta — una pagina, una fotografia, una
# misura — e portano dentro percorsi della macchina su cui sono nati. Il
# collaudo vero e' `collaudo/guarda.mjs`, e quello sta nella repository.
/collaudo/_*
